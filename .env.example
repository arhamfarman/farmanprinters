# --- Database (Supabase Postgres or self-hosted Postgres) ---
DATABASE_URL="postgresql://user:password@localhost:5432/fpp_erp?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/fpp_erp?schema=public"

# --- Auth (NextAuth) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# --- File storage: Supabase Storage or S3-compatible bucket ---
STORAGE_DRIVER="supabase" # "supabase" | "s3"
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-me"
SUPABASE_STORAGE_BUCKET="fpp-assets"

AWS_S3_BUCKET="fpp-assets"
AWS_REGION="me-central-1"
AWS_ACCESS_KEY_ID="replace-me"
AWS_SECRET_ACCESS_KEY="replace-me"

# --- Business defaults (used for PDF letterheads + numbering) ---
DEFAULT_CURRENCY="PKR"
DEFAULT_TIMEZONE="Asia/Karachi"
